# Copy to apps/web/.env.local for local dev. Real values live in Vercel / Supabase / GitHub secrets.
# `pnpm db:start` prints the local URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

APP_BASE_URL=https://themoharnetwork.com
# Printed on every note's QR code. Permanent: never change.
NOTE_URL_PREFIX=https://themoharnetwork.com/n/
